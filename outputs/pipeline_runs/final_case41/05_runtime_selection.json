  },
  "metric_definition_catalog": [
    {
      "id": 9,
      "metric_code": "AVG_DEBIT_30DAY",
      "metric_name": "Average Debit Amount - 30 Days",
      "entity_type": "CUSTOMER",
      "channel": "ALL",
      "window_type": "ROLLING",
      "window_size": "30DAY",
      "data_type": "AMOUNT",
      "aggregation_type": "CUSTOM",
      "context_code": "TRANSACTION",
      "is_active": "Y",
      "sql_statement": "\nSELECT COALESCE(AVG(COALESCE(NULLIF(tm.rule_engine_context #>> '{transaction,drCrAmount}', '')::numeric, tm.txn_amount)), 0)\nFROM efrm.transaction_master tm\nWHERE tm.institution_id = $header.institutionId\n  AND tm.source_system = $header.sourceSystem\n  AND tm.customer_id = $entity.customerId\n  AND tm.txn_timestamp >= (CAST($transaction.txnTimestamp AS timestamptz) AT TIME ZONE 'UTC') - INTERVAL '30 days'\n  AND tm.txn_timestamp < (CAST($transaction.txnTimestamp AS timestamptz) AT TIME ZONE 'UTC')\n  AND COALESCE(tm.source_txn_id, '') <> $transaction.sourceTxnId\n  AND COALESCE(\n        NULLIF(tm.rule_engine_context #>> '{transaction,drCrIndicator}', ''),\n        CASE\n            WHEN UPPER(COALESCE(tm.txn_type, '')) IN ('WITHDRAWAL', 'PURCHASE', 'CASH', 'DEBIT', 'P2P', 'P2M', 'TRANSFER') THEN 'D'\n            WHEN UPPER(COALESCE(tm.txn_type, '')) IN ('REFUND', 'REVERSAL', 'CREDIT', 'DEPOSIT') THEN 'C'\n            ELSE NULL\n        END\n      ) = 'D'\n"
    }
  ],
  "group_catalog_for_rule": [
